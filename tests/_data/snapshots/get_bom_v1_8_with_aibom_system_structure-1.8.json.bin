  "dataFlows": [
    {
      "bom-ref": "df-filter-to-llm",
      "name": "Filtered input to LLM",
      "source": "input-filter",
      "target": "claude-sonnet"
    },
    {
      "bom-ref": "df-kb-to-llm",
