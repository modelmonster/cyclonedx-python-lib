{
  "components": [
    {
      "bom-ref": "input-filter",
      "name": "Input Safety Filter",
      "trustZone": "internal-vpc",
      "type": "application"
    },
    {
      "bom-ref": "claude-sonnet",
      "name": "Claude Sonnet",
